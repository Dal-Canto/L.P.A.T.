// Grammar minimale per il DSL PhoneFree (Lark)
// Questa grammatica definisce un formato YAML-like semplificato per validazione.
// Per semplicità il prototipo usa YAML, ma la grammatica è utile per generare parser
// più rigidi o per editor con evidenziazione.

// Non Turing-complete: solo dichiarazioni chiave: valore, liste, oggetti.

start: pair+

pair: KEY ":" value

?value: STRING
      | NUMBER
      | duration
      | list
      | obj

duration: /[0-9]+[smh]/

list: "[" [value ("," value)*] "]"

obj: "{" [pair ("," pair)*] "}"

KEY: /[a-zA-Z_][a-zA-Z0-9_\-]*/
STRING: /"[^"]*"/ | /'[^']*'/
NUMBER: /[0-9]+/

%import common.WS
%ignore WS
